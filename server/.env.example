# Copy to server/.env and fill in. Only the keys for providers you use are required.

# LLM providers (SPEC 3). Model ids live only in env; check current free-tier ids in Google AI Studio.
LLM_PROVIDER=google
MAIN_MODEL=gemini-3.6-flash
CLASSIFIER_MODEL=gemini-3.5-flash-lite
# MAPPER_MODEL defaults to MAIN_MODEL
# SUMMARY_MODEL defaults to CLASSIFIER_MODEL (end-of-chat summary per patient)
# CLASSIFIER_PROVIDER=openai          # per-role override
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Voice input (SPEC 10.1): speech-to-text with GOOGLE_API_KEY; replies are read aloud by the browser
# STT_MODEL=gemini-3.5-transcribe-live
# STT_MAX_SECONDS=60

# Retrieval
EMBED_BACKEND=fastembed
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Gemini instead (free tier: 100 embedded texts/minute; cut-offs switch automatically):
# EMBED_BACKEND=gemini
# EMBED_MODEL=gemini-embedding-001
# EMBED_API_KEY=          # optional: a key from another Google account, so embeddings get their own quota (default: GOOGLE_API_KEY)
# FAQ_THRESHOLD=          # override the per-model RAG cut-offs (eval/tune_rag_threshold.py)
# CHECKLIST_THRESHOLD=

# Behaviour
CLASSIFIER_TIMEOUT_S=4
MAX_INPUT_CHARS=500
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CLINIC_NOW=2026-10-06T10:00:00+05:30   # freeze the clock (tests, golden runs)

# Storage: PostgreSQL with pgvector (SPEC 9; the RAG index lives there) and the cache dir
DATABASE_URL=postgresql+asyncpg://clinic:clinic@localhost:5432/clinic  # docker compose up -d db
# RESEED_ON_START=false              # true wipes and reloads demo data on every start
# LOG_LEVEL=INFO

# Staff portal (SPEC 17): allowed origins and the first admin (created on startup if missing)
STAFF_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please
# ADMIN_NAME=Clinic admin
# STAFF_SESSION_HOURS=12
